# Local development values come from Vercel:
#   npx vercel link
#   npx vercel env pull .env.local
# That fills in everything below except LASTFM_API_KEY, which is a write-only
# Secret. Put it in .env.development.local so `vercel env pull` never
# overwrites it. Never commit either file.

# Last.fm API key (free): https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Resolver service. Locally, run it from /resolver (see README) with this secret.
RESOLVER_URL=http://localhost:8001
RESOLVER_SECRET=

# Neon Postgres, dev branch when local.
# DATABASE_URL is the pooled connection used by the app.
# DATABASE_URL_UNPOOLED is a direct connection used by `npm run db:migrate`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional: Discord webhook for error alerts. Set it in Production only, so
# local and preview errors don't page you. Leave empty to turn alerts off.
DISCORD_ALERT_WEBHOOK_URL=

# Shared secret Vercel Cron sends to /api/cron/cleanup. Any long random string,
# Production only. Without it the cleanup route refuses every request.
CRON_SECRET=
