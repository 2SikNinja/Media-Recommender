# Copy to .env.local and fill in. Never commit .env.local.
# If the project is linked to Vercel, `npx vercel env pull .env.local` fills in
# everything Vercel has (including the Neon variables).

# Last.fm API key (free): https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Resolver service (the Python project in /resolver)
RESOLVER_URL=http://localhost:8001
RESOLVER_SECRET=

# Neon Postgres. The Vercel Neon integration sets both automatically.
# DATABASE_URL is the pooled connection used by the app.
# DATABASE_URL_UNPOOLED is a direct connection used by `npm run db:migrate`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
