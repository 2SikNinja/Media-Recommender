# Copy to .env.local and fill in. Never commit .env.local.

# Last.fm API key (free): https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Resolver service (the Python project in /resolver)
RESOLVER_URL=http://localhost:8001
RESOLVER_SECRET=

# Supabase: Project Settings > API. Server-side only, never prefix with NEXT_PUBLIC_.
# The secret key (sb_secret_...) bypasses row level security. The legacy
# service_role key also works here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
