# Copy to .env.local and fill in. Never commit .env.local.

# Last.fm API key (free): https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Resolver service (the Python project in /resolver)
RESOLVER_URL=http://localhost:8001
RESOLVER_SECRET=

# Supabase (added in a later PR)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
